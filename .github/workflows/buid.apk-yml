name: Build Android APK (Buildozer)

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  android-build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java (OpenJDK 11)
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '11'

      - name: Install system packages
        run: |
          sudo apt-get update
          sudo apt-get install -y python3-pip python3-venv git build-essential \
            libssl-dev libffi-dev zlib1g-dev libbz2-dev libsqlite3-dev unzip

      - name: Install Buildozer and Cython
        run: |
          python3 -m pip install --upgrade pip setuptools wheel
          pip install --user buildozer==1.4.2 cython==0.29.34
          export PATH="$HOME/.local/bin:$PATH"
          buildozer --version

      - name: Cache Buildozer and pip
        uses: actions/cache@v4
        with:
          path: |
            ~/.buildozer
            ~/.cache/pip
            ~/.local/share/python
          key: ${{ runner.os }}-buildozer-${{ hashFiles('**/buildozer.spec') }}-${{ hashFiles('**/requirements.txt') }}

      - name: Run Buildozer (build debug APK)
        env:
          PATH: ${{ env.HOME }}/.local/bin:${{ env.PATH }}
        run: |
          export PATH="$HOME/.local/bin:$PATH"
          # show buildozer.spec
          if [ ! -f buildozer.spec ]; then
            echo "No buildozer.spec found — make sure it's in the repo root" >&2
            exit 1
          fi
          # perform build (first run may download Android SDK/NDK)
          buildozer -v android debug

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: android-apk
          path: |
            bin/*.apk
            ./.buildozer/android/platform/build/dists/*/bin/*.apk
